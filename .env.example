# ==============================================================================
# CẤU HÌNH HỆ THỐNG CHUẨN HÓA BÁO CÁO WORD (.DOCX)
# ==============================================================================

# Khóa API DeepSeek (Điền API Key của bạn vào đây)
# Nhận API key tại: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Endpoint và Model DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Cấu hình định dạng văn bản chuẩn (Mặc định chuẩn 100% theo Mẫu form Báo cáo / Đồ án)
FONT_NAME=Times New Roman
BODY_FONT_SIZE=14
HEADING_1_FONT_SIZE=16
HEADING_2_FONT_SIZE=14
HEADING_3_FONT_SIZE=14
HEADING_4_FONT_SIZE=14
CAPTION_FONT_SIZE=14
TABLE_FONT_SIZE=14

# Căn lề trang (Margins: Top 2.5cm, Bottom 2.0cm, Left 3.5cm để đóng gáy, Right 2.0cm)
MARGIN_TOP_CM=2.5
MARGIN_BOTTOM_CM=2.0
MARGIN_LEFT_CM=3.5
MARGIN_RIGHT_CM=2.0

# Thụt lề đầu dòng Body Text (đơn vị: cm, tiêu chuẩn 1.0cm theo Mẫu form)
FIRST_LINE_INDENT_CM=1.0

# Thụt lề phân cấp cho Heading (đơn vị: cm mỗi cấp, Mẫu form chuẩn 0.0cm kịch lề trái)
HEADING_INDENT_PER_LEVEL_CM=0.0

# Khoảng cách dòng (Line spacing: 1.5 lines)
LINE_SPACING=1.5

# Khoảng cách đoạn văn Body Text (pt)
SPACE_BEFORE_PT=0
SPACE_AFTER_PT=6

# Khoảng cách đoạn cho Headings (pt)
HEADING_1_SPACE_BEFORE_PT=12
HEADING_1_SPACE_AFTER_PT=6
HEADING_SPACE_BEFORE_PT=6
HEADING_SPACE_AFTER_PT=3

# Chuẩn hóa số Chương sang số La Mã (Mặc định False để dùng CHƯƠNG 1, 2, 3 đồng bộ 1.1, 1.2)
NORMALIZE_CHAPTER_TO_ROMAN=False

# Chuẩn hóa chữ hoa cho Heading cấp con (Heading 2, 3...) sang dạng Sentence Case chuẩn
NORMALIZE_HEADING_CAPS=True

# ==============================================================================
# CẤU HÌNH CỔNG THANH TOÁN QR BANKING KHI XUẤT FILE (VIETQR & LOCAL QR)
# ==============================================================================
# Bật/Tắt hiển thị cổng thanh toán QR Banking khi chuẩn hóa xong (True / False)
ENABLE_PAYMENT_GATEWAY=True

# Mã định danh ngân hàng nhận tiền (chuẩn Napas/VietQR: MB, VCB, TCB, BIDV, ICB, VBA, ACB, VPB, TPB, STB, VIB, SHB, HDB, LPB, MSB, OCB, SEAB, NAB, BAB, BVB, PVCB, NCB, VAB, VIETBANK, SCB, PGB, CAKE, TIMO...)
BANK_ID=MB

# Số tài khoản ngân hàng của bạn (viết liền hoặc có dấu cách đều được hỗ trợ)
ACCOUNT_NO=0382838388

# Tên chủ tài khoản ngân hàng (Viết hoa không dấu hoặc có dấu)
ACCOUNT_NAME=NGUYEN VAN A

# Số tiền thanh toán / ủng hộ mặc định mỗi lần chuẩn hóa (VNĐ, mặc định 5000)
PAYMENT_AMOUNT=5000

# ==============================================================================
# CẤU HÌNH TỰ ĐỘNG CHECK BIẾN ĐỘNG SỐ DƯ NGÂN HÀNG (SEPAY API - CẤP ĐỘ 2)
# ==============================================================================
# Chế độ thanh toán:
# - 'auto'   : Cấp độ 2 - Tự động nhận diện tiền vào tài khoản qua SePay và tự động mở khóa nút tải file
# - 'manual' : Cấp độ 1 - Hiển thị mã QR và nút bấm xác nhận 'Tôi đã chuyển khoản' thủ công
PAYMENT_MODE=auto

# SePay API Token:
# Đăng ký tài khoản miễn phí tại: https://my.sepay.vn (chỉ mất 2 phút)
# Vào mục Cấu hình công ty -> Truy cập API -> Bấm "+ Thêm API" -> Sao chép API Token dán vào đây:
SEPAY_API_TOKEN=your_sepay_api_token_here

# Khoảng thời gian tự động kiểm tra số dư khi người dùng đang chờ thanh toán (giây, mặc định 3s)
PAYMENT_CHECK_INTERVAL_SECONDS=3

# Chế độ Thử nghiệm (Sandbox/Mock):
# - False: Gọi SePay API thực tế để kiểm tra tiền vào tài khoản
# - True : Cho phép mô phỏng thanh toán thành công để test toàn bộ quy trình mà không cần chuyển tiền thật
SEPAY_TEST_MODE=False
