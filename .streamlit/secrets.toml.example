# .streamlit/secrets.toml
# Mẫu file Secrets khi deploy lên Streamlit Community Cloud (hoặc chạy local)
# Có thể dùng dạng chữ HOA hoặc chữ thường, hoặc lồng trong [payment]

DEEPSEEK_API_KEY = "your_deepseek_api_key_here"
DEEPSEEK_BASE_URL = "https://api.deepseek.com"
DEEPSEEK_MODEL = "deepseek-chat"

# Cấu hình Cổng thanh toán QR Banking (VietQR & Local QR)
ENABLE_PAYMENT_GATEWAY = "True"
BANK_ID = "MB"
ACCOUNT_NO = "0382838388"
ACCOUNT_NAME = "NGUYEN VAN A"
PAYMENT_AMOUNT = "5000"

# Cấu hình Tự động check biến động số dư SePay (Cấp độ 2)
PAYMENT_MODE = "auto"
SEPAY_API_TOKEN = "your_sepay_api_token_here"
PAYMENT_CHECK_INTERVAL_SECONDS = "3"
SEPAY_TEST_MODE = "False"

# Gợi ý: Các mã ngân hàng phổ biến (Napas/VietQR):
# MB: MBBank, VCB: Vietcombank, TCB: Techcombank, BIDV: BIDV, ICB: VietinBank
# VBA: Agribank, ACB: ACB, VPB: VPBank, TPB: TPBank, STB: Sacombank
# VIB: VIB, SHB: SHB, HDB: HDBank, LPB: LPBank, MSB: MSB, OCB: OCB
# NAB: Nam A Bank, BAB: Bac A Bank, TIMO: Timo, CAKE: Cake by VPBank
